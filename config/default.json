    "signalLines": [
      "// 550C / local drawing sequence",
      "void compose_scene(frame_clock *clock) {",
      "    surface_t *frame = display_buffer;",
      "    for (int i = 0; i < GLYPH_COUNT; i++) {",
      "        glyph[i].opacity = frame_map[i];",
      "        draw_glyph(frame, glyph[i]);",
      "    }",
      "    layout_stack.align(frame->bounds);",
      "    terminal.advance(clock->elapsed);",
      "    scanline_mix(frame, phosphor_mask);",
      "    if (clock->phase == INTERFACE_WRITE) {",
      "        node_array.commit(display_map);",
      "        window_stack.reflow(frame);",
      "    }",
      "    display.present(frame);",
      "}",
      "// Every operation belongs to this scene.",
      "const int CHANNEL_COUNT = 47;",
      "const int FULL_SEQUENCE_MS = 16000;",
      "surface_map[0] = { TEXT, SYMBOL, FRAME };"
    ],
